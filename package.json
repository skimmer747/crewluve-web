{
  "name": "crewluve-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "airports": "npm install --no-save geo-tz@8.1.9 && node scripts/build-airports.mjs",
    "icons": "npm install --no-save @phosphor-icons/core@2.1.1 && node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "22.20.5",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
